{
  "folders": [
    {
      "path": ".."
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Open Terminals",
        "command": "${command:terminals.runTerminals}",
        "type": "process",
        "runOptions": {
          "runOn": "folderOpen"
        }
      }
    ]
  },
  "settings": {
    "terminals.autorun": true,
    "terminals.terminals": [
      {
        "name": "Agent Fleet",
        "color": "terminal.ansiWhite",
        "icon": "robot",
        "commands": [
          "source .env.local && echo af-worker-fleet -p agentfactory-tui"
        ]
      },
      {
        "name": "Agent Log Watch",
        "color": "terminal.ansiWhite",
        "icon": "search",
        "commands": [
          "source .env.local && echo af-analyze-logs --follow"
        ],
        "split": "Agent Fleet"
      },
      {
        "name": "donmai Dev",
        "color": "terminal.ansiYellow",
        "icon": "sparkle",
        "commands": [
          "make run-mock"
        ]
      },
      {
        "name": "Claude donmai #1",
        "color": "terminal.ansiBrightGreen",
        "icon": "squirrel",
        "commands": [
          "WT=$(./scripts/create-worktree.sh donmai-1) && cd $WT && claude --dangerously-skip-permissions --remote-control"
        ]
      },
      {
        "name": "Claude donmai #2",
        "color": "terminal.ansiBrightCyan",
        "icon": "squirrel",
        "commands": [
          "WT=$(./scripts/create-worktree.sh donmai-2) && cd $WT && claude --dangerously-skip-permissions --remote-control"
        ]
      },
      {
        "name": "Codex donmai #3",
        "color": "terminal.ansiBrightCyan",
        "icon": "squirrel",
        "commands": ["WT=$(./scripts/create-worktree.sh donmai-3) && cd $WT && ./scripts/refresh-worktree.sh && codex --dangerously-bypass-approvals-and-sandbox"],
      },
      {
        "name": "Codex donmai #4",
        "color": "terminal.ansiBrightCyan",
        "icon": "squirrel",
        "commands": ["WT=$(./scripts/create-worktree.sh donmai-4) && cd $WT && ./scripts/refresh-worktree.sh && codex --dangerously-bypass-approvals-and-sandbox"],
      },
    ]
  },
  "extensions": {
    "recommendations": [
      "golang.go",
      "fabiospampinato.vscode-terminals"
    ]
  }
}
