# Upgrade-acceptance container: a Linux image with a systemd user manager
# and delegated cgroup v2 for the N → N+1 daemon upgrade flow.
#
# BUILD CONTEXT: the donmai repo root (this file lives in
# upgradeacceptance/container/ but builds from the module root so
# `go build ./cmd/donmai` sees the whole module).
#
#   docker build -f upgradeacceptance/container/Containerfile -t donmai-upgrade-acceptance .
#
# The image ships the repo at /src plus a Go toolchain, systemd, and the
# user-manager prerequisites. The CI job (upgrade-acceptance.yml) starts it
# privileged with a delegated cgroup hierarchy, builds artifacts N and N+1
# from two revisions inside the container, installs N as a user service from
# the generated unit, and runs upgrade-acceptance.sh.
#
# The container never runs on the release-train host: only CI (and an
# operator's workstation) builds and runs it.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive GOTOOLCHAIN=local
# Go 1.26+ toolchain from the official download (Debian bookworm ships a
# Go too old for this module: go.mod requires go >= 1.26). Pinned to the
# minimum the module builds with; bump alongside the go directive in go.mod.
RUN curl -fsSL -o /tmp/go.tgz https://go.dev/dl/go1.26.6.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz
ENV PATH=/usr/local/go/bin:${PATH}
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git systemd systemd-sysv dbus nodejs npm sudo \
    && rm -rf /var/lib/apt/lists/*

# The acceptance user: the flow installs N as a USER service, so it needs a
# lingering user with its own manager. Created at build; lingering is
# enabled at container start (loginctl enable-linger) once /run/dbus and
# the delegated hierarchy exist.
RUN useradd -m -s /bin/bash acceptance \
    && echo "acceptance ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/acceptance \
    && chmod 0440 /etc/sudoers.d/acceptance

# systemd user-manager prerequisites inside a container: a delegated cgroup
# v2 hierarchy and D-Bus. The entrypoint execs systemd as PID 1; command
# dispatch inside the running unit goes through nsenter (see entrypoint.sh
# and the CI job): PID 1 must stay systemd, never the test script itself.
STOPSIGNAL SIGRTMIN+3

COPY upgradeacceptance/container/entrypoint.sh /usr/local/bin/upgrade-entrypoint.sh
RUN chmod 0755 /usr/local/bin/upgrade-entrypoint.sh

WORKDIR /src
COPY . /src

USER acceptance
RUN go version && go env GOMODCACHE

USER root
ENTRYPOINT ["/usr/local/bin/upgrade-entrypoint.sh"]
