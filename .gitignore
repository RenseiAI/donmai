bin/
!daemon/testdata/released-kit-packages/*/bin/
!daemon/testdata/released-kit-packages/*/bin/*
/af

# env files
.env
.env.*
.envrc
!.env.example

# agent state
.agent/
coverage.out

# per-worktree lint cache (scripts/create-worktree.sh points
# GOLANGCI_LINT_CACHE here so parallel worktrees cannot poison each other)
.cache/

# code-intel index (generated by `donmai code` commands; not source)
**/.donmai/code-index/

# python bytecode (scripts/test-summary.py is run by CI, never imported)
__pycache__/
*.pyc

# go cache
**/.gocache/
**/go-build/
**/.golangci-lint-cache/

dist/
