# leak-guard allowlist — one grep -E pattern per line, matched against the full
# "file:line:content" string. Keep entries NARROW so real leaks elsewhere still trip.

# `rensei.dev/v1` in agent/base.go is the Provider SDK schema apiVersion NAMESPACE
# token — a reverse-DNS schema-version identifier (corpus donmai-architecture/002
# §Manifest, Decision 3), NOT a contacted host. The OSS corpus guard (guard-b) does
# not ban `rensei.dev` and passes on 002 which specifies this exact value, so it is
# an accepted OSS namespace; only the stricter code leak-guard false-positives here.
# Scoped to agent/base.go so a genuine `agent.rensei.dev` host reference elsewhere
# still trips the PLATFORM_HOST rule.
agent/base\.go:[0-9]+:.*rensei\.dev/v1

# Package-aware consumers must continue to parse the already-published v1 wire
# namespace, and the conformance corpus is a byte-exact import of the seven
# public signed packages from donmai-kits commit 0e4621a9. These entries scope
# the accepted schema token to that parser comparison and those exact fixture
# manifests; contacted hosts or the token anywhere else still trip the guard.
daemon/kit_package\.go:[0-9]+:.*out\.Manifest\.API.*rensei\.dev/v1
daemon/testdata/released-kit-packages/(go|java|python|ruby|rust|ts-nextjs|typescript)/kit\.toml:1:api = "rensei\.dev/v1"
